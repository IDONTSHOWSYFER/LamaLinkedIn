# =================================
# Lama Linked.In API — Environment
# =================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lama_linkedin?schema=public"

# JWT Secret (CHANGE THIS in production!)
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS, emails, redirects)
FRONTEND_URL="http://localhost:5173"

# Email — Resend HTTP API (https://resend.com/api-keys)
# Si RESEND_API_KEY est absente, les emails sont des no-op (l'app ne plante pas).
RESEND_API_KEY="re_..."
EMAIL_FROM="Lama Linked.In <noreply@lamalinked.in>"
EMAIL_REPLY_TO="heycestlelama@gmail.com"

# Redis / Upstash (NoSQL — cache, rate limiting, sessions) — OPTIONNEL
# Si absent, l'API utilise un store mémoire (suffisant en mono-instance).
# Si présent mais injoignable, un disjoncteur bascule sur la mémoire sans bloquer.
# Get from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxx..."
